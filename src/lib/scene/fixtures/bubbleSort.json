{
 "title": "Bubble sort on [5, 1, 4, 2]",
 "summary": "Repeatedly compare neighbours and swap them when they are out of order. After pass i, the i largest values are in their final places.",
 "structures": [
  {
   "id": "a",
   "type": "bars",
   "label": "a"
  }
 ],
 "code": {
  "language": "python",
  "lines": [
   "def bubble_sort(a):",
   "    n = len(a)",
   "    for i in range(n - 1):",
   "        for j in range(n - 1 - i):",
   "            if a[j] > a[j + 1]:",
   "                a[j], a[j + 1] = a[j + 1], a[j]",
   "    return a"
  ]
 },
