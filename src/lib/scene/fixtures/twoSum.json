{
 "title": "Two Sum with a hash map",
 "summary": "Walk the array once. For each number, check whether its complement (target - x) was already seen; if so, that's the pair. Otherwise remember the number and its index.",
 "structures": [
  {
   "id": "nums",
   "type": "array",
   "label": "nums"
  },
  {
   "id": "seen",
   "type": "hashmap",
   "label": "seen (value → index)"
  }
 ],
 "code": {
  "language": "python",
  "lines": [
   "def two_sum(nums, target):",
   "    seen = {}",
   "    for i, x in enumerate(nums):",
   "        need = target - x",
   "        if need in seen:",
   "            return [seen[need], i]",
   "        seen[x] = i",
   "    return []"
  ]
 },
