# Copy to .env.local (or .env) and fill in.

# Base URL of the CodeQuest backend.
VITE_API_URL=http://localhost:8000

# Supabase project settings -> API.
VITE_SUPABASE_URL=https://your-project.supabase.co

# The anon/public key. This is meant to be public — it ships in the built
# JavaScript bundle. Row Level Security is what protects your data, so make sure
# the migration in the backend repo (supabase/migrations) has been applied.
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
